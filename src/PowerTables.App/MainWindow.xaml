<Window x:Class="PowerTables.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerTables" Height="690" Width="1200" WindowStartupLocation="Manual" Left="40" Top="10" Background="{DynamicResource BgBrush}" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="PowerTables" Foreground="{DynamicResource AccentBrush}" FontFamily="Segoe UI Semibold" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel x:Name="TabStrip" Orientation="Horizontal"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" x:Name="RibbonHost" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Height="88"/>
        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1" Padding="4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBox x:Name="NameBox" Grid.Column="0" Margin="0,0,4,0"/>
                <TextBlock Grid.Column="1" Text="fx" Foreground="{DynamicResource AccentBrush}" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <TextBox x:Name="FormulaBar" Grid.Column="2"/>
            </Grid>
        </Border>
        <Grid Grid.Row="3" x:Name="GridArea"/>
        <Border Grid.Row="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{DynamicResource TextDimBrush}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusLeft" DockPanel.Dock="Right" Foreground="{DynamicResource TextDimBrush}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel x:Name="SheetTabs" Orientation="Horizontal"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
