<Window x:Class="PowerTables.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerTables" Icon="Assets/powertables.ico" Height="800" Width="1400" Background="{DynamicResource BgBrush}" AllowDrop="True"
        WindowStyle="None" WindowState="Maximized" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        AutomationProperties.AutomationId="MainWindow">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <!-- barra del titolo -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" x:Name="QuickAccess"/>
            <TextBlock Grid.Column="1" x:Name="DocTitle" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13" VerticalAlignment="Center" Margin="14,0,0,0"/>
            <Border Grid.Column="3" Width="460" Height="30" CornerRadius="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" WindowChrome.IsHitTestVisibleInChrome="True">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl x:Name="SearchIcon" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="SearchBox" VerticalContentAlignment="Center" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="Cerca" IsHitTestVisible="False" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Segoe UI" FontSize="13" x:Name="SearchHint"/>
                    <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Width="420"><StackPanel x:Name="SearchResults"/></Border>
                    </Popup>
                </Grid>
            </Border>
            <StackPanel Grid.Column="5" Orientation="Horizontal" x:Name="WinButtons" WindowChrome.IsHitTestVisibleInChrome="True"/>
        </Grid>

        <!-- schede -->
        <StackPanel Grid.Row="1" x:Name="TabStrip" Orientation="Horizontal" Margin="12,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True"/>

        <!-- ribbon -->
        <Border Grid.Row="2" x:Name="RibbonOuter" Margin="10,0,10,6" CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1" Height="116">
            <ContentControl x:Name="RibbonHost" Margin="4,2,4,0"/>
        </Border>

        <!-- barra della formula -->
        <Grid Grid.Row="3" x:Name="FormulaRow" Margin="10,0,10,2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Grid.Column="0" AutomationProperties.AutomationId="NameBox" Margin="0,2,6,2"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="FormulaButtons" Margin="0,0,6,0"/>
            <TextBox x:Name="FormulaBar" Grid.Column="2" AutomationProperties.AutomationId="FormulaBar" Margin="0,2,0,2"/>
        </Grid>

        <Grid Grid.Row="4" x:Name="GridArea" Margin="10,0,10,0"/>

        <!-- schede dei fogli -->
        <DockPanel Grid.Row="5" Margin="10,0,10,0">
            <StackPanel x:Name="SheetTabs" Orientation="Horizontal"/>
        </DockPanel>

        <!-- barra di stato -->
        <Grid Grid.Row="6" Margin="12,0,12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLeftText" Text="Pronto" Foreground="{DynamicResource TextDimBrush}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusLeft" Grid.Column="1" Foreground="{DynamicResource TextDimBrush}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,24,0"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="StatusRightPanel">
                <TextBlock x:Name="StatusRight" Foreground="{DynamicResource TextDimBrush}" FontFamily="Segoe UI" FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
            </StackPanel>
        </Grid>

        <!-- scheda File a tutta pagina -->
        <Grid x:Name="Backstage" Grid.Row="1" Grid.RowSpan="6" Visibility="Collapsed" Background="{DynamicResource BgBrush}"/>

        <!-- sonda per i test UI (solo con PT_TEST_HOOKS=1) -->
        <TextBlock x:Name="Probe" Visibility="Collapsed" AutomationProperties.AutomationId="Probe"/>
    </Grid>
</Window>
